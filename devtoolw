#!/bin/sh
# DEVTOOL_WRAPPER_LAUNCHER=1
# Generated by `devtool wrapper init/update`. Do not edit by hand.
set -eu

script="$0"
# Resolve one level of symlink when readlink is available; this keeps the
# launcher useful when copied or symlinked by repo bootstrap tooling without
# requiring non-portable readlink -f.
if command -v readlink >/dev/null 2>&1 && [ -L "$script" ]; then
    link_target=$(readlink "$script" || true)
    case "$link_target" in
        /*) script="$link_target" ;;
        ?*) script="$(dirname -- "$script")/$link_target" ;;
    esac
fi

script_dir=$(dirname -- "$script")
repo_root=$(CDPATH= cd -- "$script_dir" 2>/dev/null && pwd -P) || exit 1

# Skybind-owned ergonomics for install-after-build. Devtool workflow options
# cannot be forwarded to job commands; rewrite only this explicit opt-in to
# declared wrapper commands, then use Devtool's normal resolver/executor.
case "${1:-}" in
  build|build-newfuture|build-bclone|personal-release|personal-release-newfuture|build-both)
    skybind_build_command=$1
    shift
    case "${1:-}" in
      -i|--install)
        shift
        if [ "$#" -ne 0 ]; then
            printf '%s\n' 'SKYBIND_WRAPPER_USAGE: install flag takes no additional arguments' >&2
            exit 2
        fi
        if [ "$skybind_build_command" = build-both ]; then
            printf '%s\n' 'SKYBIND_WRAPPER_USAGE: build-both cannot auto-install two module providers; choose build-bclone or build-newfuture' >&2
            exit 2
        fi
        set -- "${skybind_build_command}-install"
        ;;
      '') set -- "$skybind_build_command" ;;
      *) set -- "$skybind_build_command" "$@" ;;
    esac
    ;;
esac

# Explicit executable identity wins.  This is a path/executable override, not a
# shell fragment, so argv remains structured and no eval boundary is introduced.
if [ -n "${DEVTOOL_WRAPPER_EXECUTABLE:-}" ]; then
    if [ ! -x "$DEVTOOL_WRAPPER_EXECUTABLE" ]; then
        printf '%s\n' "DEVTOOL_WRAPPER_RUNTIME_MISSING: executable is not runnable: $DEVTOOL_WRAPPER_EXECUTABLE" >&2
        exit 127
    fi
    exec "$DEVTOOL_WRAPPER_EXECUTABLE" --repo "$repo_root" wrapper exec "$@"
fi

# Devtool dogfoods its own repository wrapper directly from the checked-out
# source tree.  This avoids silently selecting an unrelated PATH installation
# while preserving one canonical CLI/wrapper execution path.
if [ -f "$repo_root/devtool/__main__.py" ] && [ -f "$repo_root/pyproject.toml" ]; then
    wrapper_python="${DEVTOOL_WRAPPER_PYTHON:-}"
    if [ -z "$wrapper_python" ]; then
        if command -v python3 >/dev/null 2>&1; then
            wrapper_python=$(command -v python3)
        elif command -v python >/dev/null 2>&1; then
            wrapper_python=$(command -v python)
        fi
    fi
    if [ -n "$wrapper_python" ] && [ -x "$wrapper_python" ]; then
        if [ -n "${PYTHONPATH:-}" ]; then
            export PYTHONPATH="$repo_root:$PYTHONPATH"
        else
            export PYTHONPATH="$repo_root"
        fi
        exec "$wrapper_python" -m devtool --repo "$repo_root" wrapper exec "$@"
    fi
fi

if command -v devtool >/dev/null 2>&1; then
    exec "$(command -v devtool)" --repo "$repo_root" wrapper exec "$@"
fi

printf '%s\n' "DEVTOOL_WRAPPER_RUNTIME_MISSING: no Devtool runtime was found (override, source runtime, or PATH)." >&2
exit 127
