{
  "abi_major": 1,
  "consumer": "chrootctl",
  "implicit_credential_export": false,
  "native_rclone_fallback": true,
  "required_capabilities": [
    "rclone.metadata.v1",
    "rclone.read-stream.v1",
    "rclone.safe-write-stream.v1",
    "rclone.immutable-publish.v1"
  ],
  "required_operations": [
    "version",
    "lsjson",
    "cat",
    "rcat",
    "moveto --immutable",
    "deletefile"
  ],
  "schema": "skybind-rclone-consumer-request-v1"
}
