{
  "abi_major": 1,
  "consumer": "bkx",
  "implicit_credential_export": false,
  "native_rclone_fallback": true,
  "required_capabilities": [
    "rclone.metadata.v1",
    "rclone.safe-write-stream.v1",
    "rclone.restic-stdio.v1"
